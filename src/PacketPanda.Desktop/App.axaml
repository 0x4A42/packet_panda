<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PacketPanda.Desktop.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PacketPanda/Assets/Themes/Dark.axaml" />
        <ResourceInclude Source="avares://PacketPanda/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="ArcasFont">avares://PacketPanda/font#Arcas</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource ArcasFont}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource ArcasFont}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource ArcasFont}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource ArcasFont}" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontFamily" Value="{StaticResource ArcasFont}" />
    </Style>
  </Application.Styles>

</Application>
