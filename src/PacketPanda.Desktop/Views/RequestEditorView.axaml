<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PacketPanda.Desktop.ViewModels"
             xmlns:conv="using:PacketPanda.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="PacketPanda.Desktop.Views.RequestEditorView"
             x:DataType="vm:RequestEditorViewModel">

    <UserControl.Resources>
        <conv:HttpMethodBrushConverter x:Key="MethodBrushConverter" />
        <conv:AuthTypeDisplayConverter x:Key="AuthTypeDisplayConverter" />
        <conv:ApiKeyTargetDisplayConverter x:Key="ApiKeyTargetDisplayConverter" />
    </UserControl.Resources>

    <!-- Force the inner text-presenter foreground to transparent so the FluentTheme
         doesn't paint white characters over the colored TextBlock overlay when focused. -->
    <UserControl.Styles>
        <Style Selector="TextBox#UrlEditor /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="TextElement.Foreground" Value="Transparent" />
            <Setter Property="CaretBrush" Value="#1E1E1E" />
        </Style>
        <Style Selector="TextBox#BodyEditor /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="TextElement.Foreground" Value="Transparent" />
            <Setter Property="CaretBrush" Value="#1E1E1E" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,220" RowSpacing="8" Margin="12">

        <!-- URL bar: method selector | URL | Send | 💾 ▾ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding AvailableMethods}"
                      SelectedItem="{Binding SelectedMethod}"
                      MinWidth="100">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static conv:UpperCaseConverter.Instance}}"
                                   Foreground="{Binding Converter={StaticResource MethodBrushConverter}}"
                                   FontWeight="Bold" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Panel Grid.Column="1">
                <TextBox x:Name="UrlEditor"
                         Text="{Binding Url, Mode=TwoWay}"
                         AcceptsReturn="False"
                         Foreground="Transparent"
                         Background="White"
                         CaretBrush="#1E1E1E"
                         FontFamily="Consolas,Menlo,monospace"
                         FontSize="13"
                         VerticalContentAlignment="Center" />
                <TextBlock x:Name="UrlOverlay"
                           Foreground="#1E1E1E"
                           FontFamily="Consolas,Menlo,monospace"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Padding="9,0,9,0"
                           IsHitTestVisible="False" />
            </Panel>

            <Button Grid.Column="2"
                    Content="Send"
                    Command="{Binding SendCommand}" />

            <!-- Save icon + Save As caret -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0">
                <Button Command="{Binding SaveCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,6"
                        ToolTip.Tip="Save">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="💾" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" MinHeight="160">

            <!-- Body tab -->
            <TabItem Header="Body">
                <Panel Background="White">
                    <TextBox x:Name="BodyEditor"
                             Text="{Binding RequestBody}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             Foreground="Transparent"
                             Background="Transparent"
                             CaretBrush="#1E1E1E"
                             FontFamily="Consolas,Menlo,monospace"
                             FontSize="13"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             Padding="9,5,9,5" />
                    <TextBlock x:Name="BodyOverlay"
                               Foreground="#1E1E1E"
                               FontFamily="Consolas,Menlo,monospace"
                               FontSize="13"
                               Padding="9,5,9,5"
                               TextWrapping="NoWrap"
                               IsHitTestVisible="False" />
                </Panel>
            </TabItem>

            <!-- Headers tab -->
            <TabItem Header="Headers">
                <DataGrid Margin="0,4"
                          ItemsSource="{Binding Headers}"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="1"
                          BorderBrush="#DDDDDD"
                          RowHeight="34"
                          HeadersVisibility="Column"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On" Width="44" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:HeaderRowViewModel">
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Name" Width="2*" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:HeaderRowViewModel">
                                    <TextBox Text="{Binding Name}"
                                             Watermark="Name"
                                             FontFamily="Consolas,Menlo,monospace"
                                             FontSize="12"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="6,0"
                                             VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Value" Width="2*" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:HeaderRowViewModel">
                                    <TextBox Text="{Binding Value}"
                                             Watermark="Value or {{variable}}"
                                             FontFamily="Consolas,Menlo,monospace"
                                             FontSize="12"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="6,0"
                                             VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="32" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:HeaderRowViewModel">
                                    <Button Content="✕"
                                            Command="{Binding RemoveCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,0"
                                            FontSize="11"
                                            Foreground="#AAAAAA"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Cursor="Hand" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Auth tab -->
            <TabItem Header="Auth">
                <StackPanel Spacing="8" Margin="0,6">
                    <ComboBox ItemsSource="{Binding AvailableAuthTypes}"
                              SelectedItem="{Binding SelectedAuthType}"
                              MinWidth="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource AuthTypeDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Bearer Token -->
                    <StackPanel IsVisible="{Binding IsBearerAuth}" Spacing="4">
                        <TextBlock Text="Token" Opacity="0.7" FontSize="12" />
                        <TextBox Text="{Binding BearerToken}"
                                 Watermark="Token or {{variable}}"
                                 FontFamily="Consolas,Menlo,monospace"
                                 FontSize="12" />
                    </StackPanel>

                    <!-- API Key -->
                    <StackPanel IsVisible="{Binding IsApiKeyAuth}" Spacing="4">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Key name" Opacity="0.7" FontSize="12" />
                                <TextBox Text="{Binding ApiKeyName}"
                                         Watermark="e.g. X-API-Key"
                                         FontFamily="Consolas,Menlo,monospace"
                                         FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Key value" Opacity="0.7" FontSize="12" />
                                <TextBox Text="{Binding ApiKeyValue}"
                                         Watermark="Value or {{variable}}"
                                         FontFamily="Consolas,Menlo,monospace"
                                         FontSize="12" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Add to" Opacity="0.7" FontSize="12" />
                            <ComboBox ItemsSource="{Binding AvailableApiKeyTargets}"
                                      SelectedItem="{Binding ApiKeyTarget}"
                                      MinWidth="160">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ApiKeyTargetDisplayConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Basic Auth -->
                    <StackPanel IsVisible="{Binding IsBasicAuth}" Spacing="4">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Username" Opacity="0.7" FontSize="12" />
                                <TextBox Text="{Binding BasicUsername}"
                                         Watermark="Username or {{variable}}"
                                         FontFamily="Consolas,Menlo,monospace"
                                         FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Password" Opacity="0.7" FontSize="12" />
                                <TextBox Text="{Binding BasicPassword}"
                                         Watermark="Password or {{variable}}"
                                         PasswordChar="●"
                                         FontFamily="Consolas,Menlo,monospace"
                                         FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </TabItem>

        </TabControl>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
            <TextBlock Grid.Row="0"
                       Text="{Binding ErrorMessage}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        IsVisible="{Binding StatusCode, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Status:" Opacity="0.7" />
                <TextBlock Text="{Binding StatusCode}" FontWeight="SemiBold" />
                <TextBlock Text="Elapsed:" Opacity="0.7" />
                <TextBlock Text="{Binding ElapsedMilliseconds, StringFormat='{}{0} ms'}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Response body" Opacity="0.7" />

            <TextBox Grid.Row="3"
                     Text="{Binding ResponseBody}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas,Menlo,monospace"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>

        <Popup x:Name="VarPopup"
               IsOpen="False"
               Placement="Pointer"
               IsLightDismissEnabled="False">
            <Border x:Name="PopupContent"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    MinWidth="200"
                    BoxShadow="0 2 8 0 #33000000">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="PopupVarLabel"
                               FontFamily="Consolas,Menlo,monospace"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#1E1E1E" />
                    <TextBox x:Name="PopupValueBox"
                             FontFamily="Consolas,Menlo,monospace"
                             FontSize="12"
                             MinWidth="180"
                             Watermark="(empty)" />
                    <StackPanel x:Name="PopupTargetRow"
                                Orientation="Horizontal"
                                Spacing="6"
                                IsVisible="False">
                        <TextBlock Text="Save to:"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.7" />
                        <ComboBox x:Name="PopupTargetPicker"
                                  FontSize="12"
                                  MinWidth="140" />
                    </StackPanel>
                    <TextBlock x:Name="PopupHint"
                               FontSize="11"
                               Opacity="0.6" />
                    <Separator />
                    <Button x:Name="PopupEnvLink"
                            Content="Environment ↗"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            FontSize="12"
                            Foreground="#207AC1"
                            Cursor="Hand" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
