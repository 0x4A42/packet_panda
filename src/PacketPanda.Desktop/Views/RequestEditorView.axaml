<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PacketPanda.Desktop.ViewModels"
             xmlns:conv="using:PacketPanda.Desktop.Converters"
             xmlns:aedit="using:AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="PacketPanda.Desktop.Views.RequestEditorView"
             x:DataType="vm:RequestEditorViewModel">

    <UserControl.Resources>
        <conv:HttpMethodBrushConverter x:Key="MethodBrushConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Margin="12">

        <!-- URL bar: method selector | URL editor | Send | 💾 ▾ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding AvailableMethods}"
                      SelectedItem="{Binding SelectedMethod}"
                      MinWidth="100">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static conv:UpperCaseConverter.Instance}}"
                                   Foreground="{Binding Converter={StaticResource MethodBrushConverter}}"
                                   FontWeight="Bold" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Single-line URL editor with variable highlighting -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource TextControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="{DynamicResource TextControlBackground}"
                    Height="34">
                <aedit:TextEditor x:Name="UrlEditor"
                                  FontFamily="Consolas,Menlo,monospace"
                                  FontSize="13"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Background="Transparent"
                                  BorderThickness="0" />
            </Border>

            <Button Grid.Column="2"
                    Content="Send"
                    Command="{Binding SendCommand}" />

            <!-- Save icon + Save As caret -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0">
                <Button Command="{Binding SaveCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,6"
                        ToolTip.Tip="Save">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="💾" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="▾"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,6"
                        ToolTip.Tip="Save As…">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Save As…" Command="{Binding SaveAsCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="Body (JSON, optional)" Opacity="0.7" />

        <!-- Multi-line body editor with variable highlighting -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource TextControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{DynamicResource TextControlBackground}"
                Height="120">
            <aedit:TextEditor x:Name="BodyEditor"
                              FontFamily="Consolas,Menlo,monospace"
                              FontSize="13"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderThickness="0"
                              ShowLineNumbers="False" />
        </Border>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
            <TextBlock Grid.Row="0"
                       Text="{Binding ErrorMessage}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        IsVisible="{Binding StatusCode, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Status:" Opacity="0.7" />
                <TextBlock Text="{Binding StatusCode}" FontWeight="SemiBold" />
                <TextBlock Text="Elapsed:" Opacity="0.7" />
                <TextBlock Text="{Binding ElapsedMilliseconds, StringFormat='{}{0} ms'}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Response body" Opacity="0.7" />

            <TextBox Grid.Row="3"
                     Text="{Binding ResponseBody}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas,Menlo,monospace" />
        </Grid>
    </Grid>
</UserControl>
