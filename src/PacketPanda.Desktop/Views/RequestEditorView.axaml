<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PacketPanda.Desktop.ViewModels"
             xmlns:conv="using:PacketPanda.Desktop.Converters"
             xmlns:aedit="using:AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="PacketPanda.Desktop.Views.RequestEditorView"
             x:DataType="vm:RequestEditorViewModel">

    <UserControl.Resources>
        <conv:HttpMethodBrushConverter x:Key="MethodBrushConverter" />
        <conv:AuthTypeDisplayConverter x:Key="AuthTypeDisplayConverter" />
        <conv:ApiKeyTargetDisplayConverter x:Key="ApiKeyTargetDisplayConverter" />
        <conv:BodyModeDisplayConverter x:Key="BodyModeDisplayConverter" />
    </UserControl.Resources>

    <!-- Force the inner text-presenter foreground to transparent so the FluentTheme
         doesn't paint white characters over the colored TextBlock overlay when focused. -->
    <UserControl.Styles>
        <Style Selector="TextBox#UrlEditor /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="TextElement.Foreground" Value="Transparent" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBox#BodyEditor /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="TextElement.Foreground" Value="Transparent" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.send-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
        </Style>
        <Style Selector="Button.send-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        </Style>
        <!-- Request sub-tab underline style -->
        <Style Selector="TabControl.request-tabs > TabItem">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0,0,0,2" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="Padding" Value="12,8" />
          <Setter Property="FontFamily" Value="{StaticResource ArcasFont}" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="TabControl.request-tabs > TabItem:selected">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
          <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TabControl.request-tabs > TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="DataGrid">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
          <Setter Property="GridLinesVisibility" Value="Horizontal" />
        </Style>
        <Style Selector="DataGridColumnHeader">
          <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
          <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
          <Setter Property="FontFamily" Value="{StaticResource ArcasFont}" />
          <Setter Property="FontSize" Value="10" />
          <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
          <Setter Property="Fill" Value="{DynamicResource TreeRowHover}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,8,220" RowSpacing="8" Margin="12" Background="{DynamicResource AppBackground}">

        <!-- URL bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppBackground}"
                Padding="0,0,0,8">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">

            <!-- Method selector -->
            <Border Grid.Column="0"
                    Background="{DynamicResource InputBackground}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,0,4,0">
              <ComboBox ItemsSource="{Binding AvailableMethods}"
                        SelectedItem="{Binding SelectedMethod}"
                        MinWidth="90"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0,6">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={x:Static conv:UpperCaseConverter.Instance}}"
                               Foreground="{Binding Converter={StaticResource MethodBrushConverter}}"
                               FontWeight="Bold"
                               FontFamily="{StaticResource ArcasFont}"
                               FontSize="12" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Border>

            <!-- URL input with variable overlay -->
            <Border Grid.Column="1"
                    Background="{DynamicResource InputBackground}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="6">
              <Panel>
                <TextBox x:Name="UrlEditor"
                         Text="{Binding Url, Mode=TwoWay}"
                         AcceptsReturn="False"
                         Foreground="Transparent"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource TextPrimary}"
                         FontFamily="Consolas,Menlo,monospace"
                         FontSize="13"
                         Padding="10,8"
                         VerticalContentAlignment="Center" />
                <TextBlock x:Name="UrlOverlay"
                           Foreground="{DynamicResource TextPrimary}"
                           FontFamily="Consolas,Menlo,monospace"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Padding="10,8"
                           IsHitTestVisible="False" />
              </Panel>
            </Border>

            <!-- Send button -->
            <Button Grid.Column="2"
                    Classes="send-btn"
                    Command="{Binding SendCommand}"
                    Background="{DynamicResource AccentPrimary}"
                    Foreground="White"
                    FontFamily="{StaticResource ArcasFont}"
                    FontWeight="Bold"
                    FontSize="12"
                    Padding="18,8"
                    CornerRadius="6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconSend}"
                      Stretch="Uniform"
                      Width="13" Height="13"
                      Stroke="White"
                      StrokeThickness="1.5"
                      StrokeLineCap="Round"
                      Fill="Transparent" />
                <TextBlock Text="Send" Foreground="White" FontWeight="Bold" FontFamily="{StaticResource ArcasFont}" />
              </StackPanel>
            </Button>

            <!-- Save button (ghost) -->
            <Button Grid.Column="3"
                    Command="{Binding SaveCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="10,8"
                    ToolTip.Tip="Save (Ctrl+S)">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Data="{StaticResource IconSave}"
                      Stretch="Uniform"
                      Width="14" Height="14"
                      Fill="{DynamicResource TextMuted}" />
                <TextBlock Text="Save"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}"
                           FontFamily="{StaticResource ArcasFont}"
                           FontSize="12" />
              </StackPanel>
            </Button>

          </Grid>
        </Border>

        <TabControl Grid.Row="1" MinHeight="160" Classes="request-tabs">

            <!-- Params tab -->
            <TabItem Header="Params">
                <DataGrid Margin="0,4"
                          ItemsSource="{Binding QueryParams}"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal"
                          RowHeight="34"
                          HeadersVisibility="Column"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On" Width="44" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:QueryParamRowViewModel">
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Key" Width="2*" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:QueryParamRowViewModel">
                                    <TextBox Text="{Binding Key}"
                                             Watermark="Key"
                                             FontFamily="Consolas,Menlo,monospace"
                                             FontSize="12"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="6,0"
                                             VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Value" Width="2*" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:QueryParamRowViewModel">
                                    <TextBox Text="{Binding Value}"
                                             Watermark="Value or {variable}"
                                             FontFamily="Consolas,Menlo,monospace"
                                             FontSize="12"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="6,0"
                                             VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="32" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:QueryParamRowViewModel">
                                    <Button Command="{Binding RemoveCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Cursor="Hand">
                                      <Path Data="{StaticResource IconClose}"
                                            Stretch="Uniform"
                                            Width="10" Height="10"
                                            Stroke="{DynamicResource TextMuted}"
                                            StrokeThickness="2"
                                            StrokeLineCap="Round"
                                            Fill="Transparent" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Auth tab -->
            <TabItem Header="Authorisation">
                <Grid ColumnDefinitions="200,Auto,*" Margin="0,6">

                    <!-- Left: type selector + description -->
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,0,0">
                        <TextBlock Text="Auth Type" FontSize="11" Opacity="0.6" />
                        <ComboBox ItemsSource="{Binding AvailableAuthTypes}"
                                  SelectedItem="{Binding SelectedAuthType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource AuthTypeDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock IsVisible="{Binding IsBearerAuth}"
                                   Text="The Authorisation header will be automatically generated when you send the request."
                                   TextWrapping="Wrap" FontSize="11" Opacity="0.55" Margin="0,6,0,0" />
                        <TextBlock IsVisible="{Binding IsApiKeyAuth}"
                                   Text="The API key will be added to the request as a header or query parameter."
                                   TextWrapping="Wrap" FontSize="11" Opacity="0.55" Margin="0,6,0,0" />
                        <TextBlock IsVisible="{Binding IsBasicAuth}"
                                   Text="The credentials will be Base64-encoded and sent in the Authorisation header."
                                   TextWrapping="Wrap" FontSize="11" Opacity="0.55" Margin="0,6,0,0" />
                        <TextBlock IsVisible="{Binding IsNoAuth}"
                                   Text="This request does not use any authorisation."
                                   TextWrapping="Wrap" FontSize="11" Opacity="0.55" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Divider -->
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderSubtle}" Margin="16,0" />

                    <!-- Right: auth fields -->
                    <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Top">

                        <!-- Bearer Token -->
                        <Grid ColumnDefinitions="90,*" ColumnSpacing="12"
                              IsVisible="{Binding IsBearerAuth}">
                            <TextBlock Grid.Column="0" Text="Token"
                                       VerticalAlignment="Center"
                                       FontSize="12" Opacity="0.7" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding BearerToken}"
                                     Watermark="Token or {{variable}}"
                                     FontFamily="Consolas,Menlo,monospace"
                                     FontSize="12" />
                        </Grid>

                        <!-- API Key -->
                        <StackPanel IsVisible="{Binding IsApiKeyAuth}" Spacing="10">
                            <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="Key"
                                           VerticalAlignment="Center"
                                           FontSize="12" Opacity="0.7" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding ApiKeyName}"
                                         Watermark="e.g. X-API-Key"
                                         FontFamily="Consolas,Menlo,monospace"
                                         FontSize="12" />
                            </Grid>
                            <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="Value"
                                           VerticalAlignment="Center"
                                           FontSize="12" Opacity="0.7" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding ApiKeyValue}"
                                         Watermark="Value or {{variable}}"
                                         FontFamily="Consolas,Menlo,monospace"
                                         FontSize="12" />
                            </Grid>
                            <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="Add to"
                                           VerticalAlignment="Center"
                                           FontSize="12" Opacity="0.7" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableApiKeyTargets}"
                                          SelectedItem="{Binding ApiKeyTarget}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ApiKeyTargetDisplayConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <!-- Basic Auth -->
                        <StackPanel IsVisible="{Binding IsBasicAuth}" Spacing="10">
                            <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="Username"
                                           VerticalAlignment="Center"
                                           FontSize="12" Opacity="0.7" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding BasicUsername}"
                                         Watermark="Username or {{variable}}"
                                         FontFamily="Consolas,Menlo,monospace"
                                         FontSize="12" />
                            </Grid>
                            <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="Password"
                                           VerticalAlignment="Center"
                                           FontSize="12" Opacity="0.7" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding BasicPassword}"
                                         Watermark="Password or {{variable}}"
                                         PasswordChar="●"
                                         FontFamily="Consolas,Menlo,monospace"
                                         FontSize="12" />
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Headers tab -->
            <TabItem Header="Headers">
                <DataGrid Margin="0,4"
                          ItemsSource="{Binding Headers}"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal"
                          RowHeight="34"
                          HeadersVisibility="Column"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On" Width="44" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:HeaderRowViewModel">
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Name" Width="2*" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:HeaderRowViewModel">
                                    <TextBox Text="{Binding Name}"
                                             Watermark="Name"
                                             FontFamily="Consolas,Menlo,monospace"
                                             FontSize="12"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="6,0"
                                             VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Value" Width="2*" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:HeaderRowViewModel">
                                    <TextBox Text="{Binding Value}"
                                             Watermark="Value or {variable}"
                                             FontFamily="Consolas,Menlo,monospace"
                                             FontSize="12"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="6,0"
                                             VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="32" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:HeaderRowViewModel">
                                    <Button Command="{Binding RemoveCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Cursor="Hand">
                                      <Path Data="{StaticResource IconClose}"
                                            Stretch="Uniform"
                                            Width="10" Height="10"
                                            Stroke="{DynamicResource TextMuted}"
                                            StrokeThickness="2"
                                            StrokeLineCap="Round"
                                            Fill="Transparent" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Body tab -->
            <TabItem Header="Body" IsEnabled="{Binding IsBodyEnabled}">
                <Grid RowDefinitions="Auto,*">

                    <!-- Mode selector -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" Margin="0,4,0,4">
                        <ComboBox ItemsSource="{Binding AvailableBodyModes}"
                                  SelectedItem="{Binding SelectedBodyMode}"
                                  MinWidth="90">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource BodyModeDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Raw body editor (JSON / Text / XML) -->
                    <Panel Grid.Row="1" Background="White"
                           IsVisible="{Binding IsRawBodyMode}">
                        <TextBox x:Name="BodyEditor"
                                 Text="{Binding RawBodyText}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 Foreground="Transparent"
                                 Background="Transparent"
                                 CaretBrush="#1E1E1E"
                                 FontFamily="Consolas,Menlo,monospace"
                                 FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 Padding="9,5,9,5" />
                        <TextBlock x:Name="BodyOverlay"
                                   Foreground="#1E1E1E"
                                   FontFamily="Consolas,Menlo,monospace"
                                   FontSize="13"
                                   Padding="9,5,9,5"
                                   TextWrapping="NoWrap"
                                   IsHitTestVisible="False" />
                    </Panel>

                    <!-- Form-urlencoded editor -->
                    <DataGrid Grid.Row="1"
                              Margin="0,4"
                              IsVisible="{Binding IsFormBodyMode}"
                              ItemsSource="{Binding FormRows}"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal"
                              RowHeight="34"
                              HeadersVisibility="Column"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="On" Width="44" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:FormRowViewModel">
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Name" Width="2*" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:FormRowViewModel">
                                        <TextBox Text="{Binding Name}"
                                                 Watermark="Name"
                                                 FontFamily="Consolas,Menlo,monospace"
                                                 FontSize="12"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="6,0"
                                                 VerticalContentAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Value" Width="2*" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:FormRowViewModel">
                                        <TextBox Text="{Binding Value}"
                                                 Watermark="Value"
                                                 FontFamily="Consolas,Menlo,monospace"
                                                 FontSize="12"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="6,0"
                                                 VerticalContentAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="32" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:FormRowViewModel">
                                        <Button Command="{Binding RemoveCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Cursor="Hand">
                                          <Path Data="{StaticResource IconClose}"
                                                Stretch="Uniform"
                                                Width="10" Height="10"
                                                Stroke="{DynamicResource TextMuted}"
                                                StrokeThickness="2"
                                                StrokeLineCap="Round"
                                                Fill="Transparent" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- None placeholder -->
                    <Border Grid.Row="1"
                            IsVisible="{Binding IsNoneBodyMode}"
                            Padding="12">
                        <TextBlock Text="This request has no body."
                                   Opacity="0.45"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- Scripts tab -->
            <TabItem Header="Scripts">
                <Grid ColumnDefinitions="110,1,*">

                    <!-- Left: section selector -->
                    <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Top" Margin="0,4,0,0">
                        <Button x:Name="PreRequestSectionBtn"
                                Content="Pre-request"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,8"
                                FontSize="12"
                                Command="{Binding SelectPreRequestCommand}" />
                        <Button x:Name="PostResponseSectionBtn"
                                Content="Post-response"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,8"
                                FontSize="12"
                                Command="{Binding SelectPostResponseCommand}" />
                    </StackPanel>

                    <!-- Divider -->
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderSubtle}" Margin="0,4" />

                    <!-- Right: editors (toggled by IsVisible) -->
                    <aedit:TextEditor x:Name="PreRequestEditor"
                                      Grid.Column="2"
                                      IsVisible="{Binding IsPreRequestScript}"
                                      SyntaxHighlighting="JavaScript"
                                      ShowLineNumbers="True"
                                      FontFamily="Consolas,Menlo,monospace"
                                      FontSize="12"
                                      Margin="4,4,0,0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" />

                    <aedit:TextEditor x:Name="PostResponseEditor"
                                      Grid.Column="2"
                                      IsVisible="{Binding IsPostResponseScript}"
                                      SyntaxHighlighting="JavaScript"
                                      ShowLineNumbers="True"
                                      FontFamily="Consolas,Menlo,monospace"
                                      FontSize="12"
                                      Margin="4,4,0,0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

        </TabControl>

        <GridSplitter Grid.Row="2"
                      ResizeDirection="Rows"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource BorderSubtle}"
                      Cursor="SizeNorthSouth" />

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <TextBlock Grid.Row="0"
                       Text="{Binding ErrorMessage}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        IsVisible="{Binding StatusCode, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Status:" Opacity="0.7" />
                <TextBlock Text="{Binding StatusCode}" FontWeight="SemiBold" />
                <TextBlock Text="Elapsed:" Opacity="0.7" />
                <TextBlock Text="{Binding ElapsedMilliseconds, StringFormat='{}{0} ms'}" />
            </StackPanel>

            <TabControl Grid.Row="2">

                <!-- Body tab -->
                <TabItem Header="Body">
                    <TextBox Text="{Binding ResponseBody}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas,Menlo,monospace"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </TabItem>

                <!-- Cookies tab -->
                <TabItem Header="Cookies">
                    <DataGrid ItemsSource="{Binding ResponseCookies}"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal"
                              RowHeight="34"
                              HeadersVisibility="Column"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                               Binding="{Binding Name}"
                                               Width="2*"
                                               FontFamily="Consolas,Menlo,monospace"
                                               FontSize="12" />
                            <DataGridTextColumn Header="Value"
                                               Binding="{Binding Value}"
                                               Width="3*"
                                               FontFamily="Consolas,Menlo,monospace"
                                               FontSize="12" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Headers tab -->
                <TabItem Header="{Binding ResponseHeadersTabLabel}">
                    <DataGrid ItemsSource="{Binding ResponseHeaders}"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal"
                              RowHeight="34"
                              HeadersVisibility="Column"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                               Binding="{Binding Name}"
                                               Width="2*"
                                               FontFamily="Consolas,Menlo,monospace"
                                               FontSize="12" />
                            <DataGridTextColumn Header="Value"
                                               Binding="{Binding Value}"
                                               Width="3*"
                                               FontFamily="Consolas,Menlo,monospace"
                                               FontSize="12" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Tests tab -->
                <TabItem Header="{Binding TestsTabLabel}">
                    <ItemsControl ItemsSource="{Binding TestResults}" Margin="0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TestResultViewModel">
                                <Grid ColumnDefinitions="20,*" Margin="0,2">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Passed, Converter={x:Static conv:BoolToPassFailConverter.Instance}}"
                                               FontFamily="Consolas,Menlo,monospace"
                                               FontSize="12"
                                               Foreground="{Binding Passed, Converter={x:Static conv:BoolToPassFailBrushConverter.Instance}}"
                                               VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   FontSize="11"
                                                   Foreground="IndianRed"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </TabItem>

            </TabControl>
        </Grid>

        <Popup x:Name="VarPopup"
               IsOpen="False"
               Placement="Pointer"
               IsLightDismissEnabled="False">
            <Border x:Name="PopupContent"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    MinWidth="200"
                    BoxShadow="0 2 8 0 #33000000">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="PopupVarLabel"
                               FontFamily="Consolas,Menlo,monospace"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#1E1E1E" />
                    <TextBox x:Name="PopupValueBox"
                             FontFamily="Consolas,Menlo,monospace"
                             FontSize="12"
                             MinWidth="180"
                             Watermark="(empty)" />
                    <StackPanel x:Name="PopupTargetRow"
                                Orientation="Horizontal"
                                Spacing="6"
                                IsVisible="False">
                        <TextBlock Text="Save to:"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.7" />
                        <ComboBox x:Name="PopupTargetPicker"
                                  FontSize="12"
                                  MinWidth="140" />
                    </StackPanel>
                    <TextBlock x:Name="PopupHint"
                               FontSize="11"
                               Opacity="0.6" />
                    <Separator />
                    <Button x:Name="PopupEnvLink"
                            Content="Environment ↗"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            FontSize="12"
                            Foreground="#207AC1"
                            Cursor="Hand" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
