<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PacketPanda.Desktop.ViewModels"
             x:Class="PacketPanda.Desktop.Views.EnvironmentEditorView"
             x:DataType="vm:EnvironmentEditorViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <TextBlock Grid.Row="0"
                   Text="{Binding EnvironmentName}"
                   FontWeight="SemiBold"
                   FontSize="15"
                   Margin="0,0,0,10" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#DDDDDD"
                  RowHeight="34"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Variable"
                                    Binding="{Binding Name}"
                                    Width="*" />
                <DataGridTextColumn Header="Value"
                                    Binding="{Binding Value}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
            <Button Grid.Column="0"
                    Content="+ Add variable"
                    Command="{Binding AddRowCommand}"
                    Padding="10,6" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ErrorMessage}"
                       Foreground="IndianRed"
                       VerticalAlignment="Center"
                       Margin="12,0"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Grid.Column="2"
                    Content="Save"
                    Command="{Binding SaveCommand}"
                    Padding="16,6" />
        </Grid>
    </Grid>
</UserControl>
