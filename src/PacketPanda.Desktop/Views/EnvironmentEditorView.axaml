<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PacketPanda.Desktop.ViewModels"
             x:Class="PacketPanda.Desktop.Views.EnvironmentEditorView"
             x:DataType="vm:EnvironmentEditorViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <TextBlock Grid.Row="0"
                   Text="{Binding EnvironmentName}"
                   FontWeight="SemiBold"
                   FontSize="15"
                   Margin="0,0,0,10" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#DDDDDD"
                  RowHeight="34"
                  HeadersVisibility="Column"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="On"
                                        Binding="{Binding IsEnabled}"
                                        Width="36" />
                <DataGridTextColumn Header="Variable"
                                    Binding="{Binding Name}"
                                    Width="2*" />
                <DataGridTextColumn Header="Value"
                                    Binding="{Binding Value}"
                                    Width="2*" />
                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBlock Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       Foreground="IndianRed"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Grid.Column="1"
                    Content="Save"
                    Command="{Binding SaveCommand}"
                    Padding="16,6" />
        </Grid>
    </Grid>
</UserControl>
