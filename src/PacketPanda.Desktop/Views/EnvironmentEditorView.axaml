<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PacketPanda.Desktop.ViewModels"
             x:Class="PacketPanda.Desktop.Views.EnvironmentEditorView"
             x:DataType="vm:EnvironmentEditorViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Text="{Binding EnvironmentName}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="8,8,8,4" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  Margin="8,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Variable"
                                    Binding="{Binding Name}"
                                    Width="*" />
                <DataGridTextColumn Header="Value"
                                    Binding="{Binding Value}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="8,4">
            <Button Grid.Column="0"
                    Content="+ Add variable"
                    Command="{Binding AddRowCommand}"
                    Padding="8,4" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       VerticalAlignment="Center"
                       Margin="8,0"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Grid.Column="2"
                    Content="Save"
                    Command="{Binding SaveCommand}"
                    Padding="8,4" />
        </Grid>
    </Grid>
</UserControl>
