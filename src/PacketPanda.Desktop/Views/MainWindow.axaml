<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PacketPanda.Desktop.ViewModels"
        xmlns:views="using:PacketPanda.Desktop.Views"
        xmlns:conv="using:PacketPanda.Desktop.Converters"
        xmlns:envs="using:PacketPanda.Core.Environments"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="PacketPanda.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="PacketPanda"
        Width="1200" Height="800">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveActiveTabCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
        <conv:HttpMethodBrushConverter x:Key="MethodBrushConverter" />
        <conv:EqualityConverter x:Key="EqualityConverter" />

        <!-- Flat TreeViewItem template: no native chevron, indent driven by Level,
             header stretched so the whole row is clickable. -->
        <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,3,4,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <Border Name="PART_LayoutRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                MinHeight="{TemplateBinding MinHeight}"
                                Margin="{Binding Level, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:TreeIndentConverter.Instance}}"
                                TemplatedControl.IsTemplateFocusTarget="True">
                            <ContentPresenter Name="PART_HeaderPresenter"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center" />
                        </Border>
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        IsVisible="{TemplateBinding IsExpanded}"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource TreeRowHover}" />
            </Style>
            <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            </Style>
        </ControlTheme>

        <!-- Minimal chevron toggle: no FluentTheme button chrome, just the glyph -->
        <ControlTheme x:Key="TreeChevronToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
      <!-- Activity bar button base -->
      <Style Selector="Button.activity-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
      <Style Selector="Button.activity-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="Button.activity-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ActivityBarItemHover}" />
      </Style>
      <Style Selector="Button.activity-btn.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ActivityBarItemActive}" />
      </Style>
      <!-- Active nav button: icon + label brighten to primary text -->
      <Style Selector="Button.activity-btn.active Path">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
      </Style>
      <Style Selector="Button.activity-btn.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      </Style>
      <Style Selector="TabStripItem:selected Border.tab-pill">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
      </Style>
      <Style Selector="TabStripItem:selected Border.tab-pill TextBlock.tab-title">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style Selector="TabStripItem:pointerover Border.tab-pill">
        <Setter Property="Background" Value="{DynamicResource TreeRowHover}" />
      </Style>
      <!-- Environment picker: pill with leading icon, no chevron -->
      <Style Selector="ComboBox.env-picker /template/ PathIcon#DropDownGlyph">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </Window.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Left panel: activity bar (60px) + sidebar content -->
        <Grid Grid.Column="0" ColumnDefinitions="60,*">

            <!-- Activity bar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ActivityBarBackground}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,1,0">
              <Grid RowDefinitions="*,Auto">

                <!-- Top nav buttons -->
                <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,8,0,0">

                  <Button Classes="activity-btn"
                          Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Requests}}"
                          Command="{Binding SetRequestsTabCommand}"
                          ToolTip.Tip="Collections">
                    <Grid>
                      <Border Width="3" Height="20"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="0,10,0,0"
                              CornerRadius="0,2,2,0"
                              Background="{DynamicResource AccentPrimary}"
                              IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Requests}}" />
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                        <Path Data="{StaticResource IconNavCollections}"
                              Stretch="Uniform"
                              Width="20" Height="20"
                              HorizontalAlignment="Center"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Fill="Transparent" />
                        <TextBlock Text="COLLECTIONS"
                                   FontSize="7"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Button Classes="activity-btn"
                          Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Environments}}"
                          Command="{Binding SetEnvironmentsTabCommand}"
                          ToolTip.Tip="Environments">
                    <Grid>
                      <Border Width="3" Height="20"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="0,10,0,0"
                              CornerRadius="0,2,2,0"
                              Background="{DynamicResource AccentPrimary}"
                              IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Environments}}" />
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                        <Path Data="{StaticResource IconNavEnvironments}"
                              Stretch="Uniform"
                              Width="20" Height="20"
                              HorizontalAlignment="Center"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Fill="Transparent" />
                        <TextBlock Text="ENVS"
                                   FontSize="7"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Button Classes="activity-btn"
                          Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.History}}"
                          Command="{Binding SetHistoryTabCommand}"
                          ToolTip.Tip="History">
                    <Grid>
                      <Border Width="3" Height="20"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="0,10,0,0"
                              CornerRadius="0,2,2,0"
                              Background="{DynamicResource AccentPrimary}"
                              IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.History}}" />
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                        <Path Data="{StaticResource IconNavHistory}"
                              Stretch="Uniform"
                              Width="20" Height="20"
                              HorizontalAlignment="Center"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Fill="Transparent" />
                        <TextBlock Text="HISTORY"
                                   FontSize="7"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Button Classes="activity-btn"
                          Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Docs}}"
                          Command="{Binding SetDocsTabCommand}"
                          ToolTip.Tip="Docs">
                    <Grid>
                      <Border Width="3" Height="20"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="0,10,0,0"
                              CornerRadius="0,2,2,0"
                              Background="{DynamicResource AccentPrimary}"
                              IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Docs}}" />
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                        <Path Data="{StaticResource IconNavDocs}"
                              Stretch="Uniform"
                              Width="20" Height="20"
                              HorizontalAlignment="Center"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Fill="Transparent" />
                        <TextBlock Text="DOCS"
                                   FontSize="7"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" />
                      </StackPanel>
                    </Grid>
                  </Button>

                </StackPanel>

                <!-- Settings button pinned to bottom -->
                <Button Grid.Row="1"
                        Classes="activity-btn"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Settings"
                        Margin="0,0,0,8">
                  <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                    <Path Data="{StaticResource IconSettings}"
                          Stretch="Uniform"
                          Width="18" Height="18"
                          HorizontalAlignment="Center"
                          Fill="{DynamicResource TextPrimary}" />
                    <TextBlock Text="SETTINGS"
                               FontSize="7"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" />
                  </StackPanel>
                </Button>

              </Grid>
            </Border>

            <!-- Sidebar content -->
            <Grid Grid.Column="1" Background="{DynamicResource SidebarBackground}">

                <!-- Requests panel -->
                <Grid RowDefinitions="Auto,Auto,*"
                      IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Requests}}">

                    <!-- Toolbar -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*" Margin="14,8,8,6" ColumnSpacing="4">
                      <Button Grid.Column="0"
                              Classes="toolbar-icon"
                              VerticalAlignment="Center"
                              ToolTip.Tip="New collection"
                              Command="{Binding Sidebar.NewCollectionCommand}">
                        <Path Data="{StaticResource IconPlus}"
                              Stretch="Uniform"
                              Width="14" Height="14"
                              Fill="{DynamicResource TextMuted}" />
                      </Button>
                      <Button Grid.Column="1"
                              Classes="toolbar-icon"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Open…">
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="Open file(s)…" Command="{Binding Sidebar.OpenFilesCommand}" />
                            <MenuItem Header="Open folder…" Command="{Binding Sidebar.OpenFolderCommand}" />
                          </MenuFlyout>
                        </Button.Flyout>
                        <Path Data="{StaticResource IconFolder}"
                              Stretch="Uniform"
                              Width="17" Height="17"
                              Margin="0,2,0,0"
                              Fill="{DynamicResource TextMuted}" />
                      </Button>
                      <Button Grid.Column="2"
                              Classes="toolbar-icon"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Import from cURL"
                              Command="{Binding Sidebar.PasteCurlCommand}">
                        <Path Data="{StaticResource IconCode}"
                              Stretch="Uniform"
                              Width="14" Height="14"
                              Fill="{DynamicResource TextMuted}" />
                      </Button>
                      <Border Grid.Column="3"
                              Height="28"
                              Background="{DynamicResource ActivityBarBackground}"
                              BorderBrush="{DynamicResource BorderSubtle}"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="8,0">
                        <Grid ColumnDefinitions="Auto,*">
                          <Path Grid.Column="0"
                                Data="{StaticResource IconSearch}"
                                Stretch="Uniform"
                                Width="12" Height="12"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource TextMuted}" />
                          <TextBox Grid.Column="1"
                                   Watermark="Search…"
                                   Text="{Binding Sidebar.FilterText}"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   Padding="0"
                                   VerticalContentAlignment="Center"
                                   FontSize="12" />
                        </Grid>
                      </Border>
                    </Grid>

                    <!-- Error message -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Sidebar.ErrorMessage}"
                               IsVisible="{Binding Sidebar.ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                               Foreground="Red"
                               Margin="8,0,8,4"
                               TextWrapping="Wrap" />

                    <!-- Collections tree -->
                    <TreeView Grid.Row="2"
                              x:Name="CollectionTree"
                              Background="Transparent"
                              ItemsSource="{Binding Sidebar.Collections}"
                              SelectionChanged="CollectionTreeView_SelectionChanged"
                              Tapped="CollectionTreeView_Tapped"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.DataTemplates>

                            <!-- CollectionViewModel (top-level) -->
                            <TreeDataTemplate DataType="vm:CollectionViewModel"
                                              ItemsSource="{Binding Items}">
                                <Grid ColumnDefinitions="*,Auto"
                                      HorizontalAlignment="Stretch"
                                      Background="Transparent">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="New folder"
                                                      Command="{Binding NewFolderCommand}" />
                                            <MenuItem Header="Rename"
                                                      Command="{Binding RenameCommand}" />
                                            <MenuItem Header="Duplicate"
                                                      Command="{Binding DuplicateCommand}" />
                                            <MenuItem Header="Run collection"
                                                      Command="{Binding RunCollectionCommand}" />
                                            <Separator />
                                            <MenuItem Header="Remove from sidebar"
                                                      Command="{Binding RemoveCommand}" />
                                            <MenuItem Header="Delete"
                                                      Command="{Binding DeleteCommand}" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFolder}"
                                              Stretch="Uniform"
                                              Width="13" Height="13"
                                              VerticalAlignment="Center"
                                              Fill="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource ArcasBoldFont}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   IsVisible="{Binding !IsEditing}" />
                                        <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                                 IsVisible="{Binding IsEditing}"
                                                 MinWidth="80" FontWeight="SemiBold"
                                                 Padding="2,1"
                                                 LostFocus="OnRenameTextBoxLostFocus">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Return" Command="{Binding CommitRenameCommand}" />
                                                <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Theme="{StaticResource TreeChevronToggle}"
                                                  IsChecked="{Binding $parent[TreeViewItem].IsExpanded, Mode=TwoWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  CornerRadius="4"
                                                  Padding="0"
                                                  Width="20" Height="20"
                                                  VerticalAlignment="Center">
                                        <Panel>
                                          <Path Data="{StaticResource IconCaretRight}"
                                                Stretch="Uniform"
                                                Width="7" Height="7"
                                                Fill="{DynamicResource TextMuted}"
                                                IsVisible="{Binding !$parent[TreeViewItem].IsExpanded}" />
                                          <Path Data="{StaticResource IconCaretDown}"
                                                Stretch="Uniform"
                                                Width="7" Height="7"
                                                Fill="{DynamicResource TextMuted}"
                                                IsVisible="{Binding $parent[TreeViewItem].IsExpanded}" />
                                        </Panel>
                                    </ToggleButton>
                                </Grid>
                            </TreeDataTemplate>

                            <!-- CollectionNodeViewModel (folders and requests) -->
                            <TreeDataTemplate DataType="vm:CollectionNodeViewModel"
                                              ItemsSource="{Binding Children}">
                                <Grid ColumnDefinitions="*,Auto"
                                      HorizontalAlignment="Stretch"
                                      Background="Transparent">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="New request"
                                                      Command="{Binding NewRequestCommand}"
                                                      IsVisible="{Binding IsFolder}" />
                                            <MenuItem Header="New folder"
                                                      Command="{Binding NewFolderCommand}"
                                                      IsVisible="{Binding IsFolder}" />
                                            <MenuItem Header="Run folder"
                                                      Command="{Binding RunFolderCommand}"
                                                      IsVisible="{Binding IsFolder}" />
                                            <Separator IsVisible="{Binding IsFolder}" />
                                            <MenuItem Header="Rename"
                                                      Command="{Binding NodeRenameCommand}" />
                                            <MenuItem Header="Copy"
                                                      Command="{Binding CopyFolderCommand}"
                                                      IsVisible="{Binding IsFolder}" />
                                            <MenuItem Header="Duplicate"
                                                      Command="{Binding DuplicateRequestCommand}"
                                                      IsVisible="{Binding !IsFolder}" />
                                            <MenuItem Header="Delete"
                                                      Command="{Binding NodeDeleteCommand}" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Border IsVisible="{Binding Method, Converter={StaticResource IsNotNullConverter}}"
                                                Background="{Binding Method, Converter={StaticResource MethodBrushConverter}}"
                                                CornerRadius="2"
                                                Padding="4,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Method}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsEditing}" />
                                        <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                                 IsVisible="{Binding IsEditing}"
                                                 MinWidth="80"
                                                 Padding="2,1"
                                                 LostFocus="OnRenameTextBoxLostFocus">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Return" Command="{Binding CommitRenameCommand}" />
                                                <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Theme="{StaticResource TreeChevronToggle}"
                                                  IsVisible="{Binding IsFolder}"
                                                  IsChecked="{Binding $parent[TreeViewItem].IsExpanded, Mode=TwoWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  CornerRadius="4"
                                                  Padding="0"
                                                  Width="20" Height="20"
                                                  VerticalAlignment="Center">
                                        <Panel>
                                          <Path Data="{StaticResource IconCaretRight}"
                                                Stretch="Uniform"
                                                Width="7" Height="7"
                                                Fill="{DynamicResource TextMuted}"
                                                IsVisible="{Binding !$parent[TreeViewItem].IsExpanded}" />
                                          <Path Data="{StaticResource IconCaretDown}"
                                                Stretch="Uniform"
                                                Width="7" Height="7"
                                                Fill="{DynamicResource TextMuted}"
                                                IsVisible="{Binding $parent[TreeViewItem].IsExpanded}" />
                                        </Panel>
                                    </ToggleButton>
                                </Grid>
                            </TreeDataTemplate>

                        </TreeView.DataTemplates>
                    </TreeView>
                </Grid>

                <!-- Environments panel -->
                <Panel IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Environments}}">
                    <views:EnvironmentSidebarView DataContext="{Binding EnvironmentSidebar}" />
                </Panel>

                <!-- History panel -->
                <Panel IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.History}}">
                    <views:HistorySidebarView DataContext="{Binding HistorySidebar}" />
                </Panel>

                <!-- Docs panel -->
                <Panel IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Docs}}">
                    <views:DocsSidebarView DataContext="{Binding DocsSidebar}" />
                </Panel>

            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Background="{DynamicResource BorderSubtle}" ResizeDirection="Columns" />

        <Grid Grid.Column="2" RowDefinitions="Auto,*" Background="{DynamicResource AppBackground}">
            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="8,6,8,0">
              <Grid ColumnDefinitions="*,Auto">
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                  <TabStrip ItemsSource="{Binding Tabs}"
                            SelectedItem="{Binding ActiveTab}"
                            Background="Transparent">
                    <TabStrip.ItemContainerTheme>
                      <ControlTheme TargetType="TabStripItem">
                        <Setter Property="MinWidth" Value="60" />
                        <Setter Property="MaxWidth" Value="180" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                          <ControlTemplate>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                          </ControlTemplate>
                        </Setter>
                      </ControlTheme>
                    </TabStrip.ItemContainerTheme>
                    <TabStrip.ItemTemplate>
                      <DataTemplate DataType="vm:TabViewModel">
                        <Border Classes="tab-pill"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                CornerRadius="6,6,0,0"
                                Padding="8,5,8,4"
                                Margin="0,0,2,0"
                                PointerPressed="TabItem_PointerPressed">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Background="{Binding MethodLabel, Converter={StaticResource MethodBrushConverter}}"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding MethodLabel, Converter={StaticResource IsNotNullConverter}}">
                              <TextBlock Text="{Binding MethodLabel}"
                                         FontSize="9"
                                         FontWeight="Bold"
                                         Foreground="White" />
                            </Border>
                            <TextBlock Text="{Binding DisplayTitle}"
                                       Classes="tab-title"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="●"
                                       FontSize="6"
                                       Foreground="{DynamicResource AccentPrimary}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding ShowDirtyIndicator}" />
                            <Button Content="×"
                                    Command="{Binding CloseCommand}"
                                    Padding="2,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextMuted}"
                                    FontSize="13" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </TabStrip.ItemTemplate>
                  </TabStrip>
                </ScrollViewer>

                <Border Grid.Column="1"
                        Margin="8,0,4,6"
                        Height="28"
                        VerticalAlignment="Center"
                        Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="6">
                  <Grid ColumnDefinitions="Auto,*">
                    <Path Grid.Column="0"
                          Data="{StaticResource IconNavEnvironments}"
                          Stretch="Uniform"
                          Width="13" Height="13"
                          Margin="9,0,0,0"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1.5"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Fill="Transparent" />
                    <ComboBox Grid.Column="1"
                              Classes="env-picker"
                              ItemsSource="{Binding AvailableEnvironments}"
                              SelectedItem="{Binding SelectedEnvironment}"
                              PlaceholderText="No environment"
                              MaxWidth="130"
                              MinWidth="70"
                              VerticalAlignment="Center"
                              Padding="6,0"
                              FontSize="11"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource TextMuted}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="envs:EnvironmentRef">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding ActiveTab.Content}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:RequestEditorViewModel">
                        <views:RequestEditorView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:EnvironmentEditorViewModel">
                        <views:EnvironmentEditorView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:CollectionRunnerViewModel">
                        <views:CollectionRunnerView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:DocsViewerViewModel">
                        <views:DocsViewerView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
