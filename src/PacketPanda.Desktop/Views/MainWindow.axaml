<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PacketPanda.Desktop.ViewModels"
        xmlns:views="using:PacketPanda.Desktop.Views"
        xmlns:conv="using:PacketPanda.Desktop.Converters"
        xmlns:envs="using:PacketPanda.Core.Environments"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="PacketPanda.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="PacketPanda"
        Width="1200" Height="800">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveActiveTabCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
        <conv:HttpMethodBrushConverter x:Key="MethodBrushConverter" />
        <conv:EqualityConverter x:Key="EqualityConverter" />
    </Window.Resources>

    <Window.Styles>
      <!-- Activity bar button base -->
      <Style Selector="Button.activity-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="0" />
      </Style>
      <Style Selector="Button.activity-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="Button.activity-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ActivityBarItemHover}" />
      </Style>
      <Style Selector="Button.activity-btn.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ActivityBarItemActive}" />
      </Style>
      <!-- Sidebar tree row hover -->
      <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TreeRowHover}" />
      </Style>
      <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
      </Style>
    </Window.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Left panel: activity bar (60px) + sidebar content -->
        <Grid Grid.Column="0" ColumnDefinitions="60,*">

            <!-- Activity bar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ActivityBarBackground}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,1,0">
              <Grid RowDefinitions="*,Auto">

                <!-- Top nav buttons -->
                <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,8,0,0">

                  <Button Classes="activity-btn"
                          Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Requests}}"
                          Command="{Binding SetRequestsTabCommand}"
                          ToolTip.Tip="Collections">
                    <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Center">
                      <Border Grid.Row="0"
                              Width="3" Height="24"
                              HorizontalAlignment="Left"
                              Margin="-30,0,0,0"
                              Background="{DynamicResource AccentPrimary}"
                              IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Requests}}" />
                      <Path Grid.Row="0"
                            Data="{StaticResource IconCollections}"
                            Stretch="Uniform"
                            Width="20" Height="20"
                            HorizontalAlignment="Center"
                            Stroke="{DynamicResource TextMuted}"
                            StrokeThickness="1.5"
                            StrokeLineCap="Round"
                            Fill="Transparent" />
                      <TextBlock Grid.Row="1"
                                 Text="COLLECTIONS"
                                 FontSize="6.5"
                                 FontFamily="{StaticResource ArcasFont}"
                                 HorizontalAlignment="Center"
                                 Foreground="{DynamicResource TextMuted}"
                                 Margin="0,2,0,0"
                                 MaxWidth="54"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>

                  <Button Classes="activity-btn"
                          Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Environments}}"
                          Command="{Binding SetEnvironmentsTabCommand}"
                          ToolTip.Tip="Environments">
                    <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Center">
                      <Border Grid.Row="0"
                              Width="3" Height="24"
                              HorizontalAlignment="Left"
                              Margin="-30,0,0,0"
                              Background="{DynamicResource AccentPrimary}"
                              IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Environments}}" />
                      <Path Grid.Row="0"
                            Data="{StaticResource IconEnvironments}"
                            Stretch="Uniform"
                            Width="20" Height="20"
                            HorizontalAlignment="Center"
                            Stroke="{DynamicResource TextMuted}"
                            StrokeThickness="1.5"
                            StrokeLineCap="Round"
                            Fill="Transparent" />
                      <TextBlock Grid.Row="1"
                                 Text="ENVS"
                                 FontSize="6.5"
                                 FontFamily="{StaticResource ArcasFont}"
                                 HorizontalAlignment="Center"
                                 Foreground="{DynamicResource TextMuted}"
                                 Margin="0,2,0,0"
                                 MaxWidth="54"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>

                  <Button Classes="activity-btn"
                          Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Docs}}"
                          Command="{Binding SetDocsTabCommand}"
                          ToolTip.Tip="Docs">
                    <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Center">
                      <Border Grid.Row="0"
                              Width="3" Height="24"
                              HorizontalAlignment="Left"
                              Margin="-30,0,0,0"
                              Background="{DynamicResource AccentPrimary}"
                              IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Docs}}" />
                      <Path Grid.Row="0"
                            Data="{StaticResource IconDocs}"
                            Stretch="Uniform"
                            Width="20" Height="20"
                            HorizontalAlignment="Center"
                            Stroke="{DynamicResource TextMuted}"
                            StrokeThickness="1.5"
                            StrokeLineCap="Round"
                            Fill="Transparent" />
                      <TextBlock Grid.Row="1"
                                 Text="DOCS"
                                 FontSize="6.5"
                                 FontFamily="{StaticResource ArcasFont}"
                                 HorizontalAlignment="Center"
                                 Foreground="{DynamicResource TextMuted}"
                                 Margin="0,2,0,0"
                                 MaxWidth="54"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>

                </StackPanel>

                <!-- Theme toggle pinned to bottom -->
                <Button Grid.Row="1"
                        Classes="activity-btn"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip.Tip="Toggle theme"
                        Margin="0,0,0,8">
                  <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconMoon}"
                          Stretch="Uniform"
                          Width="18" Height="18"
                          HorizontalAlignment="Center"
                          Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1.5"
                          StrokeLineCap="Round"
                          Fill="Transparent"
                          IsVisible="{Binding IsDarkTheme}" />
                    <Path Data="{StaticResource IconSun}"
                          Stretch="Uniform"
                          Width="18" Height="18"
                          HorizontalAlignment="Center"
                          Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1.5"
                          StrokeLineCap="Round"
                          Fill="Transparent"
                          IsVisible="{Binding !IsDarkTheme}" />
                  </StackPanel>
                </Button>

              </Grid>
            </Border>

            <!-- Sidebar content -->
            <Grid Grid.Column="1" Background="{DynamicResource SidebarBackground}">

                <!-- Requests panel -->
                <Grid RowDefinitions="Auto,Auto,*"
                      IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Requests}}">

                    <!-- Toolbar -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="8,8,8,4">
                      <Button Grid.Column="0"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="6"
                              ToolTip.Tip="New collection"
                              Command="{Binding Sidebar.NewCollectionCommand}">
                        <Path Data="{StaticResource IconPlus}"
                              Stretch="Uniform"
                              Width="14" Height="14"
                              Fill="{DynamicResource TextMuted}" />
                      </Button>
                      <DropDownButton Grid.Column="1"
                                      Margin="2,0,0,0"
                                      Padding="6"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ToolTip.Tip="Open…">
                        <DropDownButton.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="Open file(s)…" Command="{Binding Sidebar.OpenFilesCommand}" />
                            <MenuItem Header="Open folder…" Command="{Binding Sidebar.OpenFolderCommand}" />
                          </MenuFlyout>
                        </DropDownButton.Flyout>
                        <Path Data="{StaticResource IconFolderOpen}"
                              Stretch="Uniform"
                              Width="14" Height="14"
                              Fill="{DynamicResource TextMuted}" />
                      </DropDownButton>
                      <Border Grid.Column="2"
                              Margin="4,0,0,0"
                              Background="{DynamicResource InputBackground}"
                              BorderBrush="{DynamicResource BorderSubtle}"
                              BorderThickness="1"
                              CornerRadius="5"
                              Padding="6,0,6,0">
                        <Grid ColumnDefinitions="Auto,*">
                          <Path Grid.Column="0"
                                Data="{StaticResource IconSearch}"
                                Stretch="Uniform"
                                Width="12" Height="12"
                                Margin="0,0,4,0"
                                Fill="{DynamicResource TextMuted}" />
                          <TextBox Grid.Column="1"
                                   Watermark="Search…"
                                   Text="{Binding Sidebar.FilterText}"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   Padding="0,5,0,5"
                                   FontSize="11" />
                        </Grid>
                      </Border>
                    </Grid>

                    <!-- Error message -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Sidebar.ErrorMessage}"
                               IsVisible="{Binding Sidebar.ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                               Foreground="Red"
                               Margin="8,0,8,4"
                               TextWrapping="Wrap" />

                    <!-- Collections tree -->
                    <TreeView Grid.Row="2"
                              x:Name="CollectionTree"
                              Background="Transparent"
                              ItemsSource="{Binding Sidebar.Collections}"
                              SelectionChanged="CollectionTreeView_SelectionChanged"
                              Tapped="CollectionTreeView_Tapped"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.DataTemplates>

                            <!-- CollectionViewModel (top-level) -->
                            <TreeDataTemplate DataType="vm:CollectionViewModel"
                                              ItemsSource="{Binding Items}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <StackPanel.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="New folder"
                                                      Command="{Binding NewFolderCommand}" />
                                            <MenuItem Header="Rename"
                                                      Command="{Binding RenameCommand}" />
                                            <MenuItem Header="Duplicate"
                                                      Command="{Binding DuplicateCommand}" />
                                            <MenuItem Header="Run collection"
                                                      Command="{Binding RunCollectionCommand}" />
                                            <Separator />
                                            <MenuItem Header="Remove from sidebar"
                                                      Command="{Binding $parent[TreeView].DataContext.Sidebar.RemoveCollectionCommand}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Delete"
                                                      Command="{Binding DeleteCommand}" />
                                        </MenuFlyout>
                                    </StackPanel.ContextFlyout>
                                    <Path Data="{StaticResource IconFolder}"
                                          Stretch="Uniform"
                                          Width="13" Height="13"
                                          VerticalAlignment="Center"
                                          Fill="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}"
                                               IsVisible="{Binding !IsEditing}" />
                                    <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                             IsVisible="{Binding IsEditing}"
                                             MinWidth="80" FontWeight="SemiBold"
                                             Padding="2,1"
                                             LostFocus="OnRenameTextBoxLostFocus">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Return" Command="{Binding CommitRenameCommand}" />
                                            <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <Button Content="+"
                                            IsVisible="{Binding !IsEditing}"
                                            Command="{Binding NewRequestCommand}"
                                            Padding="4,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            ToolTip.Tip="New request" />
                                    <Button IsVisible="{Binding !IsEditing}"
                                            Padding="4,0"
                                            Background="Transparent"
                                            BorderThickness="0">
                                      <Path Data="{StaticResource IconMenu}"
                                            Stretch="Uniform"
                                            Width="13" Height="13"
                                            Fill="{DynamicResource TextMuted}" />
                                      <Button.Flyout>
                                        <MenuFlyout>
                                          <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" />
                                          <MenuItem Header="Rename" Command="{Binding RenameCommand}" />
                                          <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                                          <MenuItem Header="Run collection" Command="{Binding RunCollectionCommand}" />
                                          <Separator />
                                          <MenuItem Header="Remove from sidebar"
                                                    Command="{Binding $parent[TreeView].DataContext.Sidebar.RemoveCollectionCommand}"
                                                    CommandParameter="{Binding}" />
                                          <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                                        </MenuFlyout>
                                      </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </TreeDataTemplate>

                            <!-- CollectionNodeViewModel (folders and requests) -->
                            <TreeDataTemplate DataType="vm:CollectionNodeViewModel"
                                              ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <StackPanel.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="New request"
                                                      Command="{Binding NewRequestCommand}"
                                                      IsVisible="{Binding IsFolder}" />
                                            <MenuItem Header="New folder"
                                                      Command="{Binding NewFolderCommand}"
                                                      IsVisible="{Binding IsFolder}" />
                                            <MenuItem Header="Run folder"
                                                      Command="{Binding RunFolderCommand}"
                                                      IsVisible="{Binding IsFolder}" />
                                            <Separator IsVisible="{Binding IsFolder}" />
                                            <MenuItem Header="Rename"
                                                      Command="{Binding NodeRenameCommand}" />
                                            <MenuItem Header="Copy"
                                                      Command="{Binding CopyFolderCommand}"
                                                      IsVisible="{Binding IsFolder}" />
                                            <MenuItem Header="Duplicate"
                                                      Command="{Binding DuplicateRequestCommand}"
                                                      IsVisible="{Binding !IsFolder}" />
                                            <MenuItem Header="Delete"
                                                      Command="{Binding NodeDeleteCommand}" />
                                        </MenuFlyout>
                                    </StackPanel.ContextFlyout>
                                    <Border IsVisible="{Binding Method, Converter={StaticResource IsNotNullConverter}}"
                                            Background="{Binding Method, Converter={StaticResource MethodBrushConverter}}"
                                            CornerRadius="2"
                                            Padding="4,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Method}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                               IsVisible="{Binding !IsEditing}" />
                                    <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                             IsVisible="{Binding IsEditing}"
                                             MinWidth="80"
                                             Padding="2,1"
                                             LostFocus="OnRenameTextBoxLostFocus">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Return" Command="{Binding CommitRenameCommand}" />
                                            <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <Button IsVisible="{Binding ShowFolderActions}"
                                            Content="+"
                                            Command="{Binding NewRequestCommand}"
                                            Padding="4,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            ToolTip.Tip="New request" />
                                    <Button IsVisible="{Binding ShowFolderActions}"
                                            Padding="4,0"
                                            Background="Transparent"
                                            BorderThickness="0">
                                      <Path Data="{StaticResource IconMenu}"
                                            Stretch="Uniform"
                                            Width="13" Height="13"
                                            Fill="{DynamicResource TextMuted}" />
                                      <Button.Flyout>
                                        <MenuFlyout>
                                          <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" />
                                          <MenuItem Header="Rename" Command="{Binding RenameFolderCommand}" />
                                          <MenuItem Header="Copy" Command="{Binding CopyFolderCommand}" />
                                          <MenuItem Header="Delete" Command="{Binding DeleteFolderCommand}" />
                                          <Separator />
                                          <MenuItem Header="Run folder" Command="{Binding RunFolderCommand}" />
                                        </MenuFlyout>
                                      </Button.Flyout>
                                    </Button>
                                    <Button IsVisible="{Binding ShowRequestActions}"
                                            Padding="4,0"
                                            Background="Transparent"
                                            BorderThickness="0">
                                      <Path Data="{StaticResource IconMenu}"
                                            Stretch="Uniform"
                                            Width="13" Height="13"
                                            Fill="{DynamicResource TextMuted}" />
                                      <Button.Flyout>
                                        <MenuFlyout>
                                          <MenuItem Header="Rename" Command="{Binding RenameRequestCommand}" />
                                          <MenuItem Header="Duplicate" Command="{Binding DuplicateRequestCommand}" />
                                          <MenuItem Header="Delete" Command="{Binding DeleteRequestCommand}" />
                                        </MenuFlyout>
                                      </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </TreeDataTemplate>

                        </TreeView.DataTemplates>
                    </TreeView>
                </Grid>

                <!-- Environments panel -->
                <views:EnvironmentSidebarView
                    DataContext="{Binding EnvironmentSidebar}"
                    IsVisible="{Binding $parent[Grid].DataContext.ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Environments}}" />

                <!-- Docs panel -->
                <views:DocsSidebarView
                    DataContext="{Binding DocsSidebar}"
                    IsVisible="{Binding $parent[Grid].DataContext.ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Docs}}" />

            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Background="{DynamicResource BorderSubtle}" ResizeDirection="Columns" />

        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4">
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <TabStrip ItemsSource="{Binding Tabs}"
                              SelectedItem="{Binding ActiveTab}">
                        <TabStrip.ItemContainerTheme>
                            <ControlTheme TargetType="TabStripItem">
                                <Setter Property="MinWidth" Value="80" />
                                <Setter Property="MaxWidth" Value="200" />
                            </ControlTheme>
                        </TabStrip.ItemContainerTheme>
                        <TabStrip.ItemTemplate>
                            <DataTemplate DataType="vm:TabViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            PointerPressed="TabItem_PointerPressed">
                                    <Border Background="{Binding MethodLabel, Converter={StaticResource MethodBrushConverter}}"
                                            CornerRadius="2"
                                            Padding="4,1"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding MethodLabel, Converter={StaticResource IsNotNullConverter}}">
                                        <TextBlock Text="{Binding MethodLabel}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center" />
                                    <TextBlock Text="●"
                                               FontSize="7"
                                               Foreground="#999"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding ShowDirtyIndicator}" />
                                    <Button Content="×"
                                            Command="{Binding CloseCommand}"
                                            Padding="4,0"
                                            Background="Transparent"
                                            BorderThickness="0" />
                                </StackPanel>
                            </DataTemplate>
                        </TabStrip.ItemTemplate>
                    </TabStrip>
                </ScrollViewer>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableEnvironments}"
                          SelectedItem="{Binding SelectedEnvironment}"
                          PlaceholderText="No environment"
                          Width="160"
                          Margin="4,0,4,0"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="envs:EnvironmentRef">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <ContentControl Grid.Row="1"
                            Content="{Binding ActiveTab.Content}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:RequestEditorViewModel">
                        <views:RequestEditorView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:EnvironmentEditorViewModel">
                        <views:EnvironmentEditorView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:CollectionRunnerViewModel">
                        <views:CollectionRunnerView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:DocsViewerViewModel">
                        <views:DocsViewerView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
