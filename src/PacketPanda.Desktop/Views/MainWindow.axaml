<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PacketPanda.Desktop.ViewModels"
        xmlns:views="using:PacketPanda.Desktop.Views"
        xmlns:conv="using:PacketPanda.Desktop.Converters"
        xmlns:envs="using:PacketPanda.Core.Environments"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="PacketPanda.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="PacketPanda"
        Width="1200" Height="800">

    <Window.Resources>
        <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
        <conv:HttpMethodBrushConverter x:Key="MethodBrushConverter" />
    </Window.Resources>

    <Grid ColumnDefinitions="280,4,*">
        <TabControl Grid.Column="0" TabStripPlacement="Top">
            <TabItem Header="Requests">
                <Grid RowDefinitions="Auto,*" Background="#F5F5F5">

                    <!-- Toolbar: Open + Close workspace -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0"
                                Content="Open…"
                                Background="White"
                                Margin="8,8,4,8"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenFileCommand}">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#E8E8E8" />
                                </Style>
                            </Button.Styles>
                        </Button>

                        <Button Grid.Column="1"
                                Content="×"
                                Margin="0,8,8,8"
                                Padding="8,4"
                                Background="Transparent"
                                BorderThickness="0"
                                IsVisible="{Binding Sidebar.WorkspacePath, Converter={StaticResource IsNotNullConverter}}"
                                Command="{Binding Sidebar.CloseWorkspaceCommand}"
                                ToolTip.Tip="Close workspace" />
                    </Grid>

                    <!-- Collapsable folder tree -->
                    <TreeView Grid.Row="1"
                              Background="Transparent"
                              ItemsSource="{Binding Sidebar.RootNodes}"
                              SelectedItem="{Binding Sidebar.SelectedNode}">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:CollectionNodeViewModel"
                                              ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Border IsVisible="{Binding Method, Converter={StaticResource IsNotNullConverter}}"
                                            Background="{Binding Method, Converter={StaticResource MethodBrushConverter}}"
                                            CornerRadius="2"
                                            Padding="4,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Method}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#1E1E1E"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </Grid>
            </TabItem>
            <TabItem Header="Environments">
                <views:EnvironmentSidebarView DataContext="{Binding EnvironmentSidebar}" />
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Column="1" Background="#CCCCCC" ResizeDirection="Columns" />

        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="4">
                <TabStrip ItemsSource="{Binding Tabs}"
                          SelectedItem="{Binding ActiveTab}">
                    <TabStrip.ItemTemplate>
                        <DataTemplate DataType="vm:TabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Background="{Binding MethodLabel, Converter={StaticResource MethodBrushConverter}}"
                                        CornerRadius="2"
                                        Padding="4,1"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding MethodLabel, Converter={StaticResource IsNotNullConverter}}">
                                    <TextBlock Text="{Binding MethodLabel}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="White" />
                                </Border>
                                <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center" />
                                <TextBlock Text="●"
                                           FontSize="7"
                                           Foreground="#999"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding ShowDirtyIndicator}" />
                                <Button Content="×"
                                        Command="{Binding CloseCommand}"
                                        Padding="4,0"
                                        Background="Transparent"
                                        BorderThickness="0" />
                            </StackPanel>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>

                <Button Grid.Column="1"
                        Content="+"
                        Command="{Binding NewTabCommand}"
                        Margin="4,0,0,0"
                        Padding="8,2" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding AvailableEnvironments}"
                          SelectedItem="{Binding SelectedEnvironment}"
                          PlaceholderText="No environment"
                          Width="160"
                          Margin="4,0,4,0"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="envs:EnvironmentRef">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <ContentControl Grid.Row="1"
                            Content="{Binding ActiveTab.Content}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:RequestEditorViewModel">
                        <views:RequestEditorView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:EnvironmentEditorViewModel">
                        <views:EnvironmentEditorView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
