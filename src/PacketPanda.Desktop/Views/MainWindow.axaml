<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PacketPanda.Desktop.ViewModels"
        xmlns:views="using:PacketPanda.Desktop.Views"
        xmlns:conv="using:PacketPanda.Desktop.Converters"
        xmlns:envs="using:PacketPanda.Core.Environments"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="PacketPanda.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="PacketPanda"
        Width="1200" Height="800">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveActiveTabCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
        <conv:HttpMethodBrushConverter x:Key="MethodBrushConverter" />
        <conv:EqualityConverter x:Key="EqualityConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.activity-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="62" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.activity-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#444444" />
        </Style>
        <Style Selector="Button.activity-btn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4A50" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="280,4,*">

        <!-- Left panel: activity bar (64px) + sidebar content -->
        <Grid Grid.Column="0" ColumnDefinitions="64,*">

            <!-- Activity bar -->
            <Border Grid.Column="0"
                    Background="#2D2D2D"
                    BorderBrush="#1E1E1E"
                    BorderThickness="0,0,1,0">
                <StackPanel Orientation="Vertical" Margin="0,8,0,0">

                    <Button Classes="activity-btn"
                            Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Requests}}"
                            Command="{Binding SetRequestsTabCommand}"
                            ToolTip.Tip="Requests">
                        <StackPanel Orientation="Vertical" Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="18" HorizontalAlignment="Center" Foreground="White" />
                            <TextBlock Text="Files" FontSize="9" HorizontalAlignment="Center" Foreground="#AAAAAA" />
                        </StackPanel>
                    </Button>

                    <Button Classes="activity-btn"
                            Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Environments}}"
                            Command="{Binding SetEnvironmentsTabCommand}"
                            ToolTip.Tip="Environments">
                        <StackPanel Orientation="Vertical" Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" Foreground="White" />
                            <TextBlock Text="Envs" FontSize="9" HorizontalAlignment="Center" Foreground="#AAAAAA" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

            <!-- Sidebar content -->
            <Grid Grid.Column="1" Background="#F5F5F5">

                <!-- Requests panel -->
                <Grid RowDefinitions="Auto,*"
                      IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Requests}}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0"
                                Content="Open…"
                                Background="White"
                                Margin="8,8,4,8"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenFileCommand}">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#E8E8E8" />
                                </Style>
                            </Button.Styles>
                        </Button>
                        <Button Grid.Column="1"
                                Content="×"
                                Margin="0,8,8,8"
                                Padding="8,4"
                                Background="Transparent"
                                BorderThickness="0"
                                IsVisible="{Binding Sidebar.WorkspacePath, Converter={StaticResource IsNotNullConverter}}"
                                Command="{Binding Sidebar.CloseWorkspaceCommand}"
                                ToolTip.Tip="Close workspace" />
                    </Grid>
                    <TreeView Grid.Row="1"
                              Background="Transparent"
                              ItemsSource="{Binding Sidebar.RootNodes}"
                              SelectedItem="{Binding Sidebar.SelectedNode}">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:CollectionNodeViewModel"
                                              ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Border IsVisible="{Binding Method, Converter={StaticResource IsNotNullConverter}}"
                                            Background="{Binding Method, Converter={StaticResource MethodBrushConverter}}"
                                            CornerRadius="2"
                                            Padding="4,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Method}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="#1E1E1E" VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </Grid>

                <!-- Environments panel -->
                <views:EnvironmentSidebarView
                    DataContext="{Binding EnvironmentSidebar}"
                    IsVisible="{Binding $parent[Grid].DataContext.ActiveSidebarTab, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static vm:SidebarTab.Environments}}" />

            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Background="#CCCCCC" ResizeDirection="Columns" />

        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="4">
                <TabStrip ItemsSource="{Binding Tabs}"
                          SelectedItem="{Binding ActiveTab}">
                    <TabStrip.ItemTemplate>
                        <DataTemplate DataType="vm:TabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4"
                                        PointerPressed="TabItem_PointerPressed">
                                <Border Background="{Binding MethodLabel, Converter={StaticResource MethodBrushConverter}}"
                                        CornerRadius="2"
                                        Padding="4,1"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding MethodLabel, Converter={StaticResource IsNotNullConverter}}">
                                    <TextBlock Text="{Binding MethodLabel}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="White" />
                                </Border>
                                <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center" />
                                <TextBlock Text="●"
                                           FontSize="7"
                                           Foreground="#999"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding ShowDirtyIndicator}" />
                                <Button Content="×"
                                        Command="{Binding CloseCommand}"
                                        Padding="4,0"
                                        Background="Transparent"
                                        BorderThickness="0" />
                            </StackPanel>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>

                <Button Grid.Column="1"
                        Content="+"
                        Command="{Binding NewTabCommand}"
                        Margin="4,0,0,0"
                        Padding="8,2" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding AvailableEnvironments}"
                          SelectedItem="{Binding SelectedEnvironment}"
                          PlaceholderText="No environment"
                          Width="160"
                          Margin="4,0,4,0"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="envs:EnvironmentRef">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <ContentControl Grid.Row="1"
                            Content="{Binding ActiveTab.Content}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:RequestEditorViewModel">
                        <views:RequestEditorView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:EnvironmentEditorViewModel">
                        <views:EnvironmentEditorView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
