<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PacketPanda.Desktop.ViewModels"
             xmlns:envs="using:PacketPanda.Core.Environments"
             xmlns:conv="using:PacketPanda.Desktop.Converters"
             x:Class="PacketPanda.Desktop.Views.EnvironmentSidebarView"
             x:DataType="vm:EnvironmentSidebarViewModel">

    <UserControl.Resources>
        <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Toolbar: + button, open button, and search -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="8,8,8,4">
            <Button Grid.Column="0"
                    Content="+"
                    Command="{Binding NewEnvironmentCommand}"
                    Padding="6,4"
                    FontSize="16"
                    FontWeight="Light"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip.Tip="New environment" />
            <Button Grid.Column="1"
                    Command="{Binding OpenEnvironmentFileCommand}"
                    Padding="6,4"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip.Tip="Open environment file…">
                <PathIcon Width="14" Height="14"
                          Data="M3,1 L9,1 L13,5 L13,15 L3,15 Z M9,1 L9,5 L13,5 Z" />
            </Button>
            <TextBox Grid.Column="2"
                     Text="{Binding SearchText}"
                     Watermark="Search…"
                     Margin="4,0,0,0"
                     Padding="4,2"
                     FontSize="11" />
        </Grid>

        <!-- Globals pinned row -->
        <Border Grid.Row="1"
                IsVisible="{Binding GlobalsRef, Converter={StaticResource IsNotNullConverter}}"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Margin="8,0,8,4">
            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,6"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Command="{Binding OpenEnvironmentCommand}"
                    CommandParameter="{Binding GlobalsRef}"
                    ToolTip.Tip="Global variables — always merged into every environment">
                <TextBlock Text="Globals" />
            </Button>
        </Border>

        <!-- Environment list -->
        <ListBox Grid.Row="2"
                 x:Name="EnvList"
                 ItemsSource="{Binding Items}"
                 SelectionMode="Single"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="envs:EnvironmentRef">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Cursor="Hand" />

                        <!-- Activate (✓) -->
                        <Button Grid.Column="1"
                                Content="✓"
                                Command="{Binding $parent[ListBox].DataContext.ActivateEnvironmentCommand}"
                                CommandParameter="{Binding}"
                                Padding="4,2"
                                Margin="2,0,0,0"
                                FontSize="13"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="Set as active environment" />

                        <!-- Settings/edit button with flyout -->
                        <Button Grid.Column="2"
                                Content="⚙"
                                Padding="4,2"
                                Margin="2,0,4,0"
                                FontSize="13"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="More options">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Rename"
                                              Command="{Binding $parent[ListBox].DataContext.RenameEnvironmentCommand}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Duplicate"
                                              Command="{Binding $parent[ListBox].DataContext.DuplicateEnvironmentCommand}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Delete"
                                              Command="{Binding $parent[ListBox].DataContext.DeleteEnvironmentCommand}"
                                              CommandParameter="{Binding}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
