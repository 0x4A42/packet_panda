<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PacketPanda.Desktop.ViewModels"
             xmlns:envs="using:PacketPanda.Core.Environments"
             xmlns:conv="using:PacketPanda.Desktop.Converters"
             x:Class="PacketPanda.Desktop.Views.EnvironmentSidebarView"
             x:DataType="vm:EnvironmentSidebarViewModel">

    <UserControl.Resources>
        <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Toolbar: new, open, and search -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="14,8,8,6" ColumnSpacing="4">
            <Button Grid.Column="0"
                    Classes="toolbar-icon"
                    VerticalAlignment="Center"
                    Command="{Binding NewEnvironmentCommand}"
                    ToolTip.Tip="New environment">
                <Path Data="{StaticResource IconPlus}"
                      Stretch="Uniform"
                      Width="14" Height="14"
                      Fill="{DynamicResource TextMuted}" />
            </Button>
            <Button Grid.Column="1"
                    Classes="toolbar-icon"
                    VerticalAlignment="Center"
                    Command="{Binding OpenEnvironmentFileCommand}"
                    ToolTip.Tip="Open environment file…">
                <Path Data="{StaticResource IconFolder}"
                      Stretch="Uniform"
                      Width="17" Height="17"
                      Margin="0,2,0,0"
                      Fill="{DynamicResource TextMuted}" />
            </Button>
            <Border Grid.Column="2"
                    Height="28"
                    Background="{DynamicResource ActivityBarBackground}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,0">
                <Grid ColumnDefinitions="Auto,*">
                    <Path Grid.Column="0"
                          Data="{StaticResource IconSearch}"
                          Stretch="Uniform"
                          Width="12" Height="12"
                          Margin="0,0,5,0"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource TextMuted}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText}"
                             Watermark="Search…"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             VerticalContentAlignment="Center"
                             FontSize="12" />
                </Grid>
            </Border>
        </Grid>

        <!-- Globals pinned row -->
        <Border Grid.Row="1"
                IsVisible="{Binding GlobalsRef, Converter={StaticResource IsNotNullConverter}}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Margin="8,0,8,4">
            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,6"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Command="{Binding OpenEnvironmentCommand}"
                    CommandParameter="{Binding GlobalsRef}"
                    ToolTip.Tip="Global variables — always merged into every environment">
                <TextBlock Text="Globals"
                           FontFamily="{StaticResource ArcasBoldFont}"
                           Foreground="{DynamicResource TextPrimary}" />
            </Button>
        </Border>

        <!-- Environment list -->
        <ListBox Grid.Row="2"
                 x:Name="EnvList"
                 ItemsSource="{Binding Items}"
                 SelectionMode="Single"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:EnvironmentItemViewModel">
                    <Grid Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="Set as active"
                                          Command="{Binding ActivateCommand}" />
                                <Separator />
                                <MenuItem Header="Rename"
                                          Command="{Binding RenameCommand}" />
                                <MenuItem Header="Duplicate"
                                          Command="{Binding DuplicateCommand}" />
                                <Separator />
                                <MenuItem Header="Delete"
                                          Command="{Binding DeleteCommand}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <!-- Name label (normal mode) -->
                        <TextBlock IsVisible="{Binding !IsEditing}"
                                   Text="{Binding Name}"
                                   FontSize="12"
                                   FontFamily="{StaticResource ArcasBoldFont}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Cursor="Hand" />

                        <!-- Inline rename TextBox (editing mode) -->
                        <TextBox IsVisible="{Binding IsEditing}"
                                 Text="{Binding EditingName, Mode=TwoWay}"
                                 Padding="2,1"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 LostFocus="OnRenameTextBoxLostFocus">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Return"
                                            Command="{Binding CommitRenameCommand}" />
                                <KeyBinding Gesture="Escape"
                                            Command="{Binding CancelRenameCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
