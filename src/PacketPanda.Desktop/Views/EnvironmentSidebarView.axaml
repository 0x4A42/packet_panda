<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PacketPanda.Desktop.ViewModels"
             xmlns:envs="using:PacketPanda.Core.Environments"
             xmlns:conv="using:PacketPanda.Desktop.Converters"
             x:Class="PacketPanda.Desktop.Views.EnvironmentSidebarView"
             x:DataType="vm:EnvironmentSidebarViewModel">

    <UserControl.Resources>
        <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Toolbar: + button, open button, and search -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="8,8,8,4">
            <Button Grid.Column="0"
                    Content="+"
                    Command="{Binding NewEnvironmentCommand}"
                    Padding="6,4"
                    FontSize="16"
                    FontWeight="Light"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip.Tip="New environment" />
            <Button Grid.Column="1"
                    Content="🗁"
                    Command="{Binding OpenEnvironmentFileCommand}"
                    Padding="6,4"
                    FontSize="14"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip.Tip="Open environment file…" />
            <TextBox Grid.Column="2"
                     Text="{Binding SearchText}"
                     Watermark="Search…"
                     Margin="4,0,0,0"
                     Padding="4,2"
                     FontSize="11" />
        </Grid>

        <!-- Globals pinned row -->
        <Border Grid.Row="1"
                IsVisible="{Binding GlobalsRef, Converter={StaticResource IsNotNullConverter}}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Margin="8,0,8,4">
            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,6"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Command="{Binding OpenEnvironmentCommand}"
                    CommandParameter="{Binding GlobalsRef}"
                    ToolTip.Tip="Global variables — always merged into every environment">
                <TextBlock Text="Globals" />
            </Button>
        </Border>

        <!-- Environment list -->
        <ListBox Grid.Row="2"
                 x:Name="EnvList"
                 ItemsSource="{Binding Items}"
                 SelectionMode="Single"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:EnvironmentItemViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="Rename"
                                          Command="{Binding $parent[ListBox].DataContext.RenameEnvironmentCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Duplicate"
                                          Command="{Binding $parent[ListBox].DataContext.DuplicateEnvironmentCommand}"
                                          CommandParameter="{Binding Ref}" />
                                <Separator />
                                <MenuItem Header="Delete"
                                          Command="{Binding $parent[ListBox].DataContext.DeleteEnvironmentCommand}"
                                          CommandParameter="{Binding Ref}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <!-- Name label (normal mode) -->
                        <TextBlock Grid.Column="0"
                                   IsVisible="{Binding !IsEditing}"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Cursor="Hand" />

                        <!-- Inline rename TextBox (editing mode) -->
                        <TextBox Grid.Column="0"
                                 IsVisible="{Binding IsEditing}"
                                 Text="{Binding EditingName, Mode=TwoWay}"
                                 Padding="2,1"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 LostFocus="OnRenameTextBoxLostFocus">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Return"
                                            Command="{Binding $parent[ListBox].DataContext.CommitRenameCommand}"
                                            CommandParameter="{Binding}" />
                                <KeyBinding Gesture="Escape"
                                            Command="{Binding $parent[ListBox].DataContext.CancelRenameCommand}"
                                            CommandParameter="{Binding}" />
                            </TextBox.KeyBindings>
                        </TextBox>

                        <!-- Activate (✓) hidden while editing -->
                        <Button Grid.Column="1"
                                IsVisible="{Binding !IsEditing}"
                                Content="✓"
                                Command="{Binding $parent[ListBox].DataContext.ActivateEnvironmentCommand}"
                                CommandParameter="{Binding Ref}"
                                Padding="4,2"
                                Margin="2,0,0,0"
                                FontSize="13"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="Set as active environment" />

                        <!-- Settings/edit button with flyout, hidden while editing -->
                        <Button Grid.Column="2"
                                IsVisible="{Binding !IsEditing}"
                                Content="⚙"
                                Padding="4,2"
                                Margin="2,0,4,0"
                                FontSize="13"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="More options">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Rename"
                                              Command="{Binding $parent[ListBox].DataContext.RenameEnvironmentCommand}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Duplicate"
                                              Command="{Binding $parent[ListBox].DataContext.DuplicateEnvironmentCommand}"
                                              CommandParameter="{Binding Ref}" />
                                    <Separator />
                                    <MenuItem Header="Delete"
                                              Command="{Binding $parent[ListBox].DataContext.DeleteEnvironmentCommand}"
                                              CommandParameter="{Binding Ref}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
