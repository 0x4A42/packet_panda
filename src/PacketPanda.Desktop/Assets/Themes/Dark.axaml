<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="AppBackground"           Color="#1A1A1F" />
  <SolidColorBrush x:Key="SidebarBackground"       Color="#141418" />
  <SolidColorBrush x:Key="ActivityBarBackground"   Color="#0F0F12" />
  <SolidColorBrush x:Key="SurfaceBackground"       Color="#2C2C38" />
  <SolidColorBrush x:Key="BorderSubtle"            Color="#2E2E38" />
  <SolidColorBrush x:Key="TextPrimary"             Color="#E8E8F0" />
  <SolidColorBrush x:Key="TextMuted"               Color="#6B6B7E" />
  <SolidColorBrush x:Key="AccentPrimary"           Color="#7C5CFC" />
  <SolidColorBrush x:Key="AccentHover"             Color="#9174FD" />
  <SolidColorBrush x:Key="ActivityBarItemHover"    Color="#1A1A1F" />
  <SolidColorBrush x:Key="ActivityBarItemActive"   Color="#1A1A1F" />
  <SolidColorBrush x:Key="MethodGet"               Color="#3FB950" />
  <SolidColorBrush x:Key="MethodPost"              Color="#F78166" />
  <SolidColorBrush x:Key="MethodPut"               Color="#E3A329" />
  <SolidColorBrush x:Key="MethodDelete"            Color="#F85149" />
  <SolidColorBrush x:Key="MethodPatch"             Color="#A371F7" />
  <SolidColorBrush x:Key="StatusSuccess"           Color="#3FB950" />
  <SolidColorBrush x:Key="StatusError"             Color="#F85149" />
  <SolidColorBrush x:Key="InputBackground"         Color="#26262F" />
  <SolidColorBrush x:Key="InputBorder"             Color="#2E2E38" />
  <SolidColorBrush x:Key="TreeRowHover"            Color="#1E1E28" />

  <!-- Keep FluentTheme text inputs dark (and text legible) when hovered/focused -->
  <SolidColorBrush x:Key="TextControlBackground"            Color="#26262F" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#26262F" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused"     Color="#26262F" />
  <SolidColorBrush x:Key="TextControlForeground"            Color="#E8E8F0" />
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E8E8F0" />
  <SolidColorBrush x:Key="TextControlForegroundFocused"     Color="#E8E8F0" />

</ResourceDictionary>
